# Docker host bind address.
# Keep 127.0.0.1 when serving through Caddy/Nginx.
# Use 0.0.0.0 only for direct server IP access.
BUNPO_LOOP_BIND=127.0.0.1

# Host port for Docker Compose.
BUNPO_LOOP_PORT=8000

# Optional HTTP Basic Auth for the whole web app.
# Leave both empty for personal/local use behind a private network.
APP_USER=
APP_PASSWORD=

# Seed bundled JLPT decks into a fresh SQLite database.
# Set to 0 if you want a completely blank app after deleting the volume.
BUNPO_LOOP_SEED_DEFAULT_DATA=1
